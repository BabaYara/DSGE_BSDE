import os, pathlib, sys, importlib
root = pathlib.Path(os.getcwd())           # Typically Tex/.out during pythontex
texdir = root.parent                       # Tex directory
scripts = texdir / "scripts"
scripts.mkdir(parents=True, exist_ok=True)
sys.path.append(str(scripts))
import ito_helpers as ih  # type: ignore
ih = importlib.reload(ih)  # ensure latest edits are used
out = root / "build" / "ito_share_identities.tex"  # place alongside other .out artefacts
out.parent.mkdir(parents=True, exist_ok=True)
ih.emit_share_identities_tex(outpath=str(out))
